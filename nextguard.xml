<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
  <name>plg_system_nextguard</name>
  <author>NextGuard</author>
  <creationDate>2026</creationDate>
  <authorUrl>https://nextguardhq.com</authorUrl>
  <version>1.2.0</version>
  <description>Syncs installed Joomla extensions to NextGuard for continuous CVE monitoring.</description>
  <targetplatform name="joomla" version="4\.(.*)" />
  <targetplatform name="joomla" version="5\.(.*)" />
  <files>
    <filename plugin="nextguard">nextguard.php</filename>
    <folder>fields</folder>
    <folder>language</folder>
  </files>
  <languages>
    <language tag="en-GB">language/en-GB/en-GB.plg_system_nextguard.ini</language>
  </languages>
  <config>
    <fields name="params" addfieldpath="/plugins/system/nextguard/fields">
      <fieldset name="basic">
        <field
          name="api_key"
          type="password"
          label="API Key"
          description="Your NextGuard API key. Account keys start with vs_pk_; free anonymous keys start with vs_pk_anon_ and scan instantly."
          default=""
        />
        <field
          name="project_id"
          type="text"
          label="Project ID"
          description="Auto-filled after Device Auth authorization."
          default=""
        />
        <field
          name="token"
          type="text"
          label="Device Token"
          description="Auto-filled after Device Auth authorization. Do not edit manually."
          default=""
        />
        <field
          name="project_name"
          type="text"
          label="Project Name"
          description="Auto-filled after Device Auth authorization."
          default=""
        />
        <field name="last_preview"    type="hidden" default="" />
        <field name="register_url"    type="hidden" default="" />
        <field name="syncs_remaining" type="hidden" default="" />
        <field name="max_syncs"       type="hidden" default="" />
        <field name="last_scan"       type="hidden" default="" />
        <field name="plan_links"      type="hidden" default="" />
        <field
          name="panel"
          type="nextguardpanel"
          label=""
        />
      </fieldset>
    </fields>
  </config>
</extension>
